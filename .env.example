# Every environment variable Nabvy reads, with empty values. Copy to .env and fill in locally;
# never commit .env. Where each value comes from is in docs/secrets.md. Each service validates
# only the groups it uses (packages/config/src/env.ts); empty values count as unset.
# Values marked "default" fall back to the documented configuration when left empty.

# Database (Supabase project fbapfy, transaction pooler)
DATABASE_URL=
DATABASE_URL_PIPELINE=
DATABASE_URL_AUTH=

# Supabase Storage (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (Better Auth, Turnstile, Google)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
ADMIN_EMAILS=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# Apify
APIFY_TOKEN=
APIFY_FB_ACTOR_ID=
APIFY_FB_ACTOR_FALLBACK_ID=
APIFY_GUMTREE_ACTOR_ID=

# Exchange rate, updated weekly
USD_GBP_RATE=

# Provider spend caps in pence (defaults 1000, 500, 5)
FB_DAILY_CAP_MINOR=
GUMTREE_DAILY_CAP_MINOR=
SCAN_SPEND_CAP_MINOR=

# Seller ID hashing
SELLER_HASH_SALT=

# eBay (EBAY_ENV is sandbox or production; EBAY_INSIGHTS_ENABLED default false)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_ENV=
EBAY_INSIGHTS_ENABLED=
EBAY_EPN_CAMPAIGN_ID=

# CeX web API (defaults https://wss2.cex.uk.webuy.io/v3 and 300)
CEX_API_BASE=
CEX_DAILY_CAP_CALLS=

# Models (defaults claude-haiku-4-5-20251001, claude-sonnet-5, claude-sonnet-5)
ANTHROPIC_API_KEY=
MODEL_DEFAULT=
MODEL_ESCALATION=
MODEL_VISION=

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Notifications
TELEGRAM_BOT_TOKEN=
FOUNDER_TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_EXTRA_AREA=
STRIPE_PRICE_TOPUP_5=
STRIPE_PRICE_TOPUP_10=
STRIPE_PRICE_TOPUP_25=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Dub (affiliates)
DUB_API_KEY=
DUB_PROGRAM_ID=
NEXT_PUBLIC_DUB_DOMAIN=

# Enrichment (default https://api.postcodes.io)
POSTCODES_IO_BASE=

# Observability (POSTHOG_HOST default https://eu.i.posthog.com)
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=

# Inventory and resale: encrypts eBay refresh tokens at rest
TOKEN_ENCRYPTION_KEY=

# Tests (default false; true enables live adapter smoke tests)
LIVE_PROVIDERS=
