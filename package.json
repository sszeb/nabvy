{
  "name": "nabvy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:conventions": "node scripts/check-conventions.mjs",
    "format": "biome format --write .",
    "test": "turbo run test --concurrency=3",
    "test:fixtures": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/fixtures/src/cli.ts",
    "db:generate": "pnpm --filter @nabvy/db db:generate",
    "db:migrate": "node packages/db/scripts/migrate.mjs apply",
    "db:dry-run": "bash scripts/db-dry-run.sh",
    "db:seed": "pnpm --filter @nabvy/db db:seed",
    "auth:generate": "pnpm --filter @nabvy/db auth:generate",
    "dev:web": "node scripts/pending.mjs dev:web 0.5a",
    "trigger:dev": "node scripts/pending.mjs trigger:dev 1.2",
    "db:plan": "node packages/db/scripts/migrate.mjs plan",
    "new:module": "node scripts/new-module.mjs",
    "interfaces": "node scripts/interface-digest.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
