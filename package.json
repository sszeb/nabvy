{
  "name": "nabvy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "test:fixtures": "node scripts/pending.mjs test:fixtures 0.6",
    "db:generate": "node scripts/pending.mjs db:generate 0.3",
    "db:migrate": "node scripts/pending.mjs db:migrate 0.3",
    "db:dry-run": "bash scripts/db-dry-run.sh",
    "db:seed": "node scripts/pending.mjs db:seed 0.3",
    "auth:generate": "node scripts/pending.mjs auth:generate 0.3",
    "dev:web": "node scripts/pending.mjs dev:web 0.5a",
    "trigger:dev": "node scripts/pending.mjs trigger:dev 1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
