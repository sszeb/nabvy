{
  "id": "gpu-pc",
  "version": "1",
  "gate": {
    "includeTitle": [
      "\\b(rtx|gtx|radeon|rx ?\\d{4}|arc a\\d{3}|geforce|graphics card|gpu|gaming pc|gaming computer|desktop pc|custom (built )?pc|pc build|tower|workstation|ryzen|core i[3579]|i[3579]-\\d{4,5})\\b",
      { "ref": "fields.GPU model" },
      { "ref": "listingKind.cpuOrPcTitle" }
    ],
    "excludeTitle": [
      { "ref": "listingKind.wantedTitle" },
      { "ref": "listingKind.laptopTitle" },
      "\\b(box only|empty box)\\b"
    ],
    "minPriceMinor": 500,
    "detailFetchAll": { "categories": ["computers"] }
  },
  "noise": [
    {
      "rule": "wanted_advert",
      "test": "wanted_advert",
      "patterns": [
        { "ref": "listingKind.wantedTitle" },
        { "ref": "listingKind.wantedDescriptionFirst400Chars" }
      ]
    },
    {
      "rule": "swap_advert",
      "test": "swap_advert",
      "patterns": [{ "ref": "listingKind.wantedTitle" }]
    },
    {
      "rule": "i_buy_advert",
      "test": "i_buy_advert",
      "patterns": [
        { "ref": "listingKind.wantedTitle" },
        { "ref": "listingKind.wantedDescriptionFirst400Chars" }
      ]
    },
    {
      "rule": "keyword_stuffing",
      "test": "keyword_stuffing",
      "patterns": [{ "ref": "fields.GPU model" }]
    },
    {
      "rule": "laptop",
      "test": "laptop",
      "patterns": [{ "ref": "listingKind.laptopTitle" }]
    },
    {
      "rule": "mention_only",
      "test": "mention_only",
      "patterns": [{ "ref": "fields.GPU model" }, { "ref": "fields.CPU model" }]
    }
  ],
  "valuation": {
    "conditionMultipliers": {
      "new": 1.1,
      "used_working": 1,
      "untested": 0.7,
      "faulty": 0.35,
      "unknown": 0.85
    },
    "bundleHaircut": 0.15,
    "bundleFixedAllowanceMinor": 6000,
    "feePct": 0.129,
    "feeFixedMinor": 30,
    "postageMinor": { "gpu": 800, "pc": 2500 },
    "travelPerKmMinor": 25,
    "expectedRepairMinor": { "used_working": 0, "untested": 4000, "faulty": 12000 }
  },
  "risk": [
    {
      "flag": "mining",
      "test": "mining",
      "action": "weight",
      "weight": 0.15,
      "patterns": ["\\b(mining|hash\\s*rate|mining rig|hydro|lhr[\\s-]*unlocked)\\b"]
    },
    {
      "flag": "untested",
      "test": "untested",
      "action": "weight",
      "weight": 0.1,
      "patterns": ["\\buntested\\b|\\bno way (to|of) test(ing)?\\b|\\bsold as seen\\b"]
    },
    {
      "flag": "stock_photo",
      "test": "stock_photo_known_image",
      "action": "weight",
      "weight": 0.2
    },
    {
      "flag": "reused_photos",
      "test": "reused_photos",
      "action": "internal",
      "shadowWeight": 0.2,
      "params": { "minListings": 3 }
    },
    {
      "flag": "deposit_request",
      "test": "deposit_request",
      "action": "weight",
      "weight": 0.3,
      "patterns": [
        "\\bdeposit\\b|\\bbank transfer\\b|\\bhold (it|them|this|for)\\b|\\bpay(ment)? first\\b|\\bdelivery only\\b"
      ]
    },
    {
      "flag": "new_seller",
      "test": "new_seller",
      "action": "internal",
      "shadowWeight": 0.15,
      "params": { "firstSeenDays": 7 }
    },
    {
      "flag": "price_far_below_floor",
      "test": "price_far_below_floor",
      "action": "weight",
      "weight": 0.35,
      "params": { "askBelowBandLowFraction": 0.5 }
    },
    {
      "flag": "parts_only",
      "test": "parts_only",
      "action": "weight",
      "weight": 0.1,
      "patterns": ["\\bfor parts\\b|\\bspares (or|and|&) repairs?\\b|\\bnot working\\b"]
    },
    {
      "flag": "wanted_post",
      "test": "wanted_post",
      "action": "drop",
      "patterns": [{ "ref": "listingKind.wantedTitle" }]
    },
    {
      "flag": "empty_box",
      "test": "empty_box",
      "action": "drop",
      "patterns": ["\\b(box only|empty box)\\b"]
    }
  ],
  "explanationTemplate": "Asking £{ask} for {itemSummary}. Similar {product} sold for £{low}–£{high} in the last 90 days (median £{mid}, {trend}). CeX pays £{cexCash} cash. After eBay fees and {collectionOrPostage}, expected margin £{margin} ({dealScore}/100). {flagsSentence}",
  "embeddingModel": "Xenova/clip-vit-base-patch32"
}
