      "checkConstraints": {
        "budgets_name_check": {
          "name": "budgets_name_check",
          "value": "\"spend_governor\".\"budgets\".\"name\" ~ '^[a-z][a-z0-9]*(-[a-z0-9]+)*$'"
        },
        "budgets_provider_check": {
          "name": "budgets_provider_check",
          "value": "\"spend_governor\".\"budgets\".\"provider\" is null or \"spend_governor\".\"budgets\".\"provider\" in ('apify', 'anthropic', 'ebay', 'cex')"
        },
        "budgets_unit_check": {
          "name": "budgets_unit_check",
          "value": "\"spend_governor\".\"budgets\".\"unit\" in ('USD', 'GBP', 'GB')"
        },
        "budgets_period_check": {
          "name": "budgets_period_check",
          "value": "\"spend_governor\".\"budgets\".\"period\" = 'month'"
        },
        "budgets_limit_check": {
          "name": "budgets_limit_check",
          "value": "\"spend_governor\".\"budgets\".\"limit_micros\" > 0"
        },
        "budgets_set_by_check": {
          "name": "budgets_set_by_check",
          "value": "length(\"spend_governor\".\"budgets\".\"set_by\") > 0"
        }
      },
