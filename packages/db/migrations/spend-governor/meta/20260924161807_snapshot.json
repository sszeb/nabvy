        "throttle_amounts_check": {
          "name": "throttle_amounts_check",
          "value": "coalesce(\"spend_governor\".\"throttle\".\"committed_micros\", 0) >= 0 and coalesce(\"spend_governor\".\"throttle\".\"forecast_micros\", 0) >= 0"
        },
