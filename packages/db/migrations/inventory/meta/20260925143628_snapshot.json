      "checkConstraints": {
        "items_names_something": {
          "name": "items_names_something",
          "value": "\"inventory\".\"items\".\"product_key\" is not null or \"inventory\".\"items\".\"source_listing_id\" is not null or \"inventory\".\"items\".\"scan_id\" is not null"
        },
        "items_product_key": {
          "name": "items_product_key",
          "value": "\"inventory\".\"items\".\"product_key\" is null or (length(\"inventory\".\"items\".\"product_key\") <= 200 and \"inventory\".\"items\".\"product_key\" ~ '^[a-z0-9-]+(:[a-z0-9-]+)+$')"
        },
        "items_currency": {
          "name": "items_currency",
          "value": "\"inventory\".\"items\".\"currency\" in ('GBP', 'EUR')"
        },
        "items_cost_minor": {
          "name": "items_cost_minor",
          "value": "\"inventory\".\"items\".\"cost_minor\" between 0 and 100000000"
        },
        "items_sold_minor": {
          "name": "items_sold_minor",
          "value": "\"inventory\".\"items\".\"sold_minor\" is null or \"inventory\".\"items\".\"sold_minor\" between 0 and 100000000"
        },
        "items_bought_at": {
          "name": "items_bought_at",
          "value": "\"inventory\".\"items\".\"bought_at\" >= '2000-01-01'::date"
        },
        "items_sale_together": {
          "name": "items_sale_together",
          "value": "(\"inventory\".\"items\".\"sold_minor\" is null) = (\"inventory\".\"items\".\"sold_at\" is null) and (\"inventory\".\"items\".\"sold_minor\" is null) = (\"inventory\".\"items\".\"sold_recorded_at\" is null)"
        },
        "items_sold_after_bought": {
          "name": "items_sold_after_bought",
          "value": "\"inventory\".\"items\".\"sold_at\" is null or \"inventory\".\"items\".\"sold_at\" >= \"inventory\".\"items\".\"bought_at\""
        },
        "items_sold_on": {
          "name": "items_sold_on",
          "value": "\"inventory\".\"items\".\"sold_on\" is null or (\"inventory\".\"items\".\"sold_minor\" is not null and \"inventory\".\"items\".\"sold_on\" in ('ebay', 'facebook', 'gumtree', 'vinted', 'cex'))"
        }
      },
      "isRLSEnabled": false
