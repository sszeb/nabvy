        "resolutions_pass_check": {
          "name": "resolutions_pass_check",
          "value": "\"pickup_location\".\"resolutions\".\"pass\" in ('card', 'detail')"
        },
        "resolutions_hash_check": {
          "name": "resolutions_hash_check",
          "value": "evidence_hash ~ '^[0-9a-f]{64}$'"
        },
        "resolutions_version_check": {
          "name": "resolutions_version_check",
          "value": "rule_version ~ '^r[0-9]+\\.[0-9a-f]{8}$'"
        },
        "resolutions_status_check": {
          "name": "resolutions_status_check",
          "value": "status in ('confirmed', 'from_description', 'conflicting', 'field_only', 'uncertain', 'unknown')"
        },
        "resolutions_basis_check": {
          "name": "resolutions_basis_check",
          "value": "basis in ('field', 'text', 'ai', 'fallback')"
        },
        "resolutions_source_check": {
          "name": "resolutions_source_check",
          "value": "source in ('both', 'description', 'listing', 'none')"
        },
        "resolutions_confidence_check": {
          "name": "resolutions_confidence_check",
          "value": "\"pickup_location\".\"resolutions\".\"confidence\" in ('high', 'medium', 'low', 'none')"
        },
        "resolutions_decided_by_check": {
          "name": "resolutions_decided_by_check",
          "value": "\"pickup_location\".\"resolutions\".\"decided_by\" in ('rules', 'ai', 'review')"
        },
        "resolutions_note_check": {
          "name": "resolutions_note_check",
          "value": "note_code is null or note_code in ('description_says_collection_from', 'listed_in', 'description_names_other_pickup', 'description_delivers_elsewhere', 'pickup_place_not_stated')"
        },
        "resolutions_district_check": {
          "name": "resolutions_district_check",
          "value": "\"pickup_location\".\"resolutions\".\"area_district\" is null or \"pickup_location\".\"resolutions\".\"area_district\" ~ '^[A-Z]{1,2}[0-9]{1,2}$'"
        },
        "resolutions_point_check": {
          "name": "resolutions_point_check",
          "value": "(\"pickup_location\".\"resolutions\".\"lat\" is null) = (\"pickup_location\".\"resolutions\".\"lng\" is null)\n        and (\"pickup_location\".\"resolutions\".\"lat\" is null or \"pickup_location\".\"resolutions\".\"lat\" between -90 and 90)\n        and (\"pickup_location\".\"resolutions\".\"lng\" is null or \"pickup_location\".\"resolutions\".\"lng\" between -180 and 180)"
        },
        "resolutions_area_check": {
          "name": "resolutions_area_check",
          "value": "(\"pickup_location\".\"resolutions\".\"town_or_area\" is null) = (\"pickup_location\".\"resolutions\".\"area_id\" is null) and (\"pickup_location\".\"resolutions\".\"town_or_area\" is null) = (\"pickup_location\".\"resolutions\".\"lat\" is null)"
        },
        "resolutions_uncertainty_check": {
          "name": "resolutions_uncertainty_check",
          "value": "\"pickup_location\".\"resolutions\".\"uncertainty_km\" is null or \"pickup_location\".\"resolutions\".\"uncertainty_km\" between 0 and 500"
        }
      },
      "isRLSEnabled": false
    }
