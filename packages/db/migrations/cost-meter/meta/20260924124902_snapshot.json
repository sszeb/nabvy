      "checkConstraints": {
        "provider_calls_provider_check": {
          "name": "provider_calls_provider_check",
          "value": "\"cost_meter\".\"provider_calls\".\"provider\" in ('apify', 'anthropic', 'ebay', 'cex')"
        },
        "provider_calls_kind_check": {
          "name": "provider_calls_kind_check",
          "value": "\"cost_meter\".\"provider_calls\".\"kind\" in ('actor_run', 'model_call', 'api_call')"
        },
        "provider_calls_currency_check": {
          "name": "provider_calls_currency_check",
          "value": "\"cost_meter\".\"provider_calls\".\"currency\" in ('USD', 'GBP')"
        },
        "provider_calls_status_check": {
          "name": "provider_calls_status_check",
          "value": "\"cost_meter\".\"provider_calls\".\"status\" in ('pending', 'succeeded', 'failed')"
        },
        "provider_calls_amounts_check": {
          "name": "provider_calls_amounts_check",
          "value": "\"cost_meter\".\"provider_calls\".\"reserved_micros\" >= 0 and \"cost_meter\".\"provider_calls\".\"reserved_gbp_micros\" >= 0 and coalesce(\"cost_meter\".\"provider_calls\".\"settled_micros\", 0) >= 0 and coalesce(\"cost_meter\".\"provider_calls\".\"settled_gbp_micros\", 0) >= 0 and \"cost_meter\".\"provider_calls\".\"usd_gbp_rate\" > 0"
        },
        "provider_calls_settlement_check": {
          "name": "provider_calls_settlement_check",
          "value": "(\"cost_meter\".\"provider_calls\".\"settled_at\" is null) = (\"cost_meter\".\"provider_calls\".\"settled_micros\" is null) and (\"cost_meter\".\"provider_calls\".\"settled_at\" is null) = (\"cost_meter\".\"provider_calls\".\"settled_gbp_micros\" is null)"
        },
        "provider_calls_latency_check": {
          "name": "provider_calls_latency_check",
          "value": "\"cost_meter\".\"provider_calls\".\"latency_ms\" is null or \"cost_meter\".\"provider_calls\".\"latency_ms\" >= 0"
        }
      },
