      "checkConstraints": {
        "scan_events_method": {
          "name": "scan_events_method",
          "value": "\"scan_recognition\".\"scan_events\".\"method\" in ('barcode', 'cex_box', 'vision', 'none')"
        },
        "scan_events_status": {
          "name": "scan_events_status",
          "value": "\"scan_recognition\".\"scan_events\".\"status\" in ('identified', 'needs_confirmation', 'unidentified')"
        },
        "scan_events_barcode_format": {
          "name": "scan_events_barcode_format",
          "value": "\"scan_recognition\".\"scan_events\".\"barcode\" ~ '^([0-9]{8}|[0-9]{12,14})$'"
        },
        "scan_events_photo_ref_per_user": {
          "name": "scan_events_photo_ref_per_user",
          "value": "\"scan_recognition\".\"scan_events\".\"photo_ref\" like 'scans/' || \"scan_recognition\".\"scan_events\".\"user_id\"::text || '/%'"
        },
        "scan_events_photo_media_type": {
          "name": "scan_events_photo_media_type",
          "value": "\"scan_recognition\".\"scan_events\".\"photo_media_type\" in ('image/jpeg', 'image/png', 'image/webp')"
        },
        "scan_events_confidence_range": {
          "name": "scan_events_confidence_range",
          "value": "\"scan_recognition\".\"scan_events\".\"confidence\" between 0 and 1"
        },
        "scan_events_candidates_max": {
          "name": "scan_events_candidates_max",
          "value": "cardinality(\"scan_recognition\".\"scan_events\".\"candidates\") <= 3"
        },
        "scan_events_identified_is_candidate": {
          "name": "scan_events_identified_is_candidate",
          "value": "\"scan_recognition\".\"scan_events\".\"identified\" is null or \"scan_recognition\".\"scan_events\".\"identified\" = any(\"scan_recognition\".\"scan_events\".\"candidates\")"
        },
        "scan_events_status_consistent": {
          "name": "scan_events_status_consistent",
          "value": "(\"scan_recognition\".\"scan_events\".\"status\" = 'identified') = (\"scan_recognition\".\"scan_events\".\"identified\" is not null)\n        and (\"scan_recognition\".\"scan_events\".\"status\" <> 'needs_confirmation' or cardinality(\"scan_recognition\".\"scan_events\".\"candidates\") > 0)\n        and (not \"scan_recognition\".\"scan_events\".\"confirmed\" or \"scan_recognition\".\"scan_events\".\"identified\" is not null)"
        },
        "scan_events_cost_nonnegative": {
          "name": "scan_events_cost_nonnegative",
          "value": "\"scan_recognition\".\"scan_events\".\"cost_gbp_micros\" >= 0"
        },
        "scan_events_model_fields": {
          "name": "scan_events_model_fields",
          "value": "\"scan_recognition\".\"scan_events\".\"model_called\" or (\"scan_recognition\".\"scan_events\".\"model_ref\" is null and \"scan_recognition\".\"scan_events\".\"output_valid\" is null and \"scan_recognition\".\"scan_events\".\"cost_gbp_micros\" = 0)"
        }
      },
