        "cells_week_start_monday_check": {
          "name": "cells_week_start_monday_check",
          "value": "extract(isodow from \"demand_signals\".\"cells\".\"week_start\") = 1"
        },
        "cells_wants_check": {
          "name": "cells_wants_check",
          "value": "\"demand_signals\".\"cells\".\"wants\" is null or \"demand_signals\".\"cells\".\"wants\" >= 10"
        },
        "cells_adverts_check": {
          "name": "cells_adverts_check",
          "value": "\"demand_signals\".\"cells\".\"adverts\" is null or \"demand_signals\".\"cells\".\"adverts\" >= 10"
        },
        "cells_suppressed_check": {
          "name": "cells_suppressed_check",
          "value": "\"demand_signals\".\"cells\".\"suppressed\" = (\"demand_signals\".\"cells\".\"wants\" is null and \"demand_signals\".\"cells\".\"adverts\" is null)"
        },
        "cells_centre_id_check": {
          "name": "cells_centre_id_check",
          "value": "length(\"demand_signals\".\"cells\".\"centre_id\") between 1 and 64"
        },
        "cells_family_check": {
          "name": "cells_family_check",
          "value": "length(\"demand_signals\".\"cells\".\"family\") between 1 and 200"
        },
        "cells_rule_version_check": {
          "name": "cells_rule_version_check",
