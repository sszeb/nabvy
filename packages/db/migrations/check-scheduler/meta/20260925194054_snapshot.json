      "checkConstraints": {
        "check_runs_kind": {
          "name": "check_runs_kind",
          "value": "\"check_scheduler\".\"check_runs\".\"kind\" in ('newest', 'catch-up', 'sweep')"
        },
        "check_runs_shape": {
          "name": "check_runs_shape",
          "value": "\"check_scheduler\".\"check_runs\".\"shape\" in ('verification', 'newest-check', 'sweep-narrow', 'sweep-broad')"
        },
        "check_runs_reason": {
          "name": "check_runs_reason",
          "value": "\"check_scheduler\".\"check_runs\".\"reason\" in ('scheduled', 'rerun', 'one-off', 'verification')"
        },
        "check_runs_status": {
          "name": "check_runs_status",
          "value": "\"check_scheduler\".\"check_runs\".\"status\" in ('pending', 'submitted', 'refused', 'shadow')"
        },
        "check_runs_terms": {
          "name": "check_runs_terms",
          "value": "cardinality(\"check_scheduler\".\"check_runs\".\"terms\") between 1 and 20 and array_position(\"check_scheduler\".\"check_runs\".\"terms\", null) is null"
        },
        "check_runs_job": {
          "name": "check_runs_job",
          "value": "(\"check_scheduler\".\"check_runs\".\"status\" = 'submitted') = (\"check_scheduler\".\"check_runs\".\"job_id\" is not null)"
        },
        "check_runs_tick": {
          "name": "check_runs_tick",
          "value": "(\"check_scheduler\".\"check_runs\".\"status\" = 'pending') = (\"check_scheduler\".\"check_runs\".\"tick_at\" is null)"
        },
        "check_runs_rerun": {
          "name": "check_runs_rerun",
          "value": "(\"check_scheduler\".\"check_runs\".\"reason\" = 'rerun') = (\"check_scheduler\".\"check_runs\".\"rerun_of\" is not null)"
        },
        "check_runs_one_off": {
          "name": "check_runs_one_off",
          "value": "(\"check_scheduler\".\"check_runs\".\"reason\" in ('one-off', 'verification')) = (\"check_scheduler\".\"check_runs\".\"one_off_id\" is not null)"
        }
      },
