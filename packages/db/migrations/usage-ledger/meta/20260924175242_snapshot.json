      "checkConstraints": {
        "entries_kind": {
          "name": "entries_kind",
          "value": "\"usage_ledger\".\"entries\".\"kind\" in ('allowance', 'taste', 'referral', 'topup', 'charge', 'reversal', 'expiry')"
        },
        "entries_credits_sign": {
          "name": "entries_credits_sign",
          "value": "case when \"usage_ledger\".\"entries\".\"kind\" in ('allowance', 'taste', 'referral', 'topup') then \"usage_ledger\".\"entries\".\"credits\" > 0\n               when \"usage_ledger\".\"entries\".\"kind\" = 'charge' then \"usage_ledger\".\"entries\".\"credits\" <= 0\n               when \"usage_ledger\".\"entries\".\"kind\" = 'reversal' then \"usage_ledger\".\"entries\".\"credits\" >= 0\n               else \"usage_ledger\".\"entries\".\"credits\" < 0 end"
        },
        "entries_action": {
          "name": "entries_action",
          "value": "(\"usage_ledger\".\"entries\".\"kind\" = 'charge') = (\"usage_ledger\".\"entries\".\"action\" is not null)"
        },
        "entries_reverses": {
          "name": "entries_reverses",
          "value": "(\"usage_ledger\".\"entries\".\"kind\" = 'reversal') = (\"usage_ledger\".\"entries\".\"reverses_id\" is not null)"
        },
        "entries_cash": {
          "name": "entries_cash",
          "value": "\"usage_ledger\".\"entries\".\"cash_minor\" >= 0 and (\"usage_ledger\".\"entries\".\"cash_minor\" = 0 or \"usage_ledger\".\"entries\".\"kind\" in ('allowance', 'topup'))"
        },
        "entries_cost": {
          "name": "entries_cost",
          "value": "\"usage_ledger\".\"entries\".\"cost_gbp_micros\" >= 0 and (\"usage_ledger\".\"entries\".\"cost_gbp_micros\" = 0 or \"usage_ledger\".\"entries\".\"kind\" = 'charge')"
        },
        "entries_expires": {
          "name": "entries_expires",
          "value": "\"usage_ledger\".\"entries\".\"expires_at\" is null or \"usage_ledger\".\"entries\".\"kind\" in ('allowance', 'taste', 'referral', 'topup')"
        },
        "entries_policy_version": {
          "name": "entries_policy_version",
          "value": "\"usage_ledger\".\"entries\".\"policy_version\" is null or \"usage_ledger\".\"entries\".\"kind\" in ('allowance', 'topup')"
        },
        "entries_expiring_kinds": {
          "name": "entries_expiring_kinds",
          "value": "\"usage_ledger\".\"entries\".\"kind\" not in ('allowance', 'taste') or \"usage_ledger\".\"entries\".\"expires_at\" is not null"
        }
      },
