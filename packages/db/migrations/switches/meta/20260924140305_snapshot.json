      "checkConstraints": {
        "switches_name_format": {
          "name": "switches_name_format",
          "value": "\"switches\".\"switches\".\"name\" ~ '^[a-z][a-z0-9]*(-[a-z0-9]+)*$' and length(\"switches\".\"switches\".\"name\") <= 100"
        },
        "switches_kind": {
          "name": "switches_kind",
          "value": "\"switches\".\"switches\".\"kind\" in ('module', 'provider', 'gate', 'flag', 'global')"
        },
        "switches_state": {
          "name": "switches_state",
          "value": "\"switches\".\"switches\".\"state\" in ('off', 'shadow', 'on')"
        },
        "switches_shadow_modules_only": {
          "name": "switches_shadow_modules_only",
          "value": "\"switches\".\"switches\".\"kind\" = 'module' or \"switches\".\"switches\".\"state\" <> 'shadow'"
        },
        "switches_allow_list_gates_only": {
          "name": "switches_allow_list_gates_only",
          "value": "\"switches\".\"switches\".\"kind\" = 'gate' or \"switches\".\"switches\".\"allow_list\" is null"
        },
        "switches_allow_list_size": {
          "name": "switches_allow_list_size",
          "value": "\"switches\".\"switches\".\"allow_list\" is null or cardinality(\"switches\".\"switches\".\"allow_list\") between 1 and 1000"
        },
        "switches_always_on": {
          "name": "switches_always_on",
          "value": "\"switches\".\"switches\".\"name\" not in ('audit-log', 'incidents', 'switches') or \"switches\".\"switches\".\"state\" = 'on'"
        }
      },
      "isRLSEnabled": false
