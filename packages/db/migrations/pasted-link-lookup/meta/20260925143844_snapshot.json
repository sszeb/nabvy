          "value": "\"pasted_link_lookup\".\"requests\".\"status\" in ('queued', 'ready', 'failed')"
        },
        "requests_ready_at": {
          "name": "requests_ready_at",
          "value": "(\"pasted_link_lookup\".\"requests\".\"status\" = 'ready') = (\"pasted_link_lookup\".\"requests\".\"ready_at\" is not null)"
