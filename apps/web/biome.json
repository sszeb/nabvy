{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": false,
  "extends": "//",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": ["**", "!next-env.d.ts", "!test-results", "!playwright-report"]
  },
  "overrides": [
    {
      "includes": ["src/app/globals.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
